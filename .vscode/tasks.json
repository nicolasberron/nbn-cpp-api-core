    "inputs": [
        {
            "id": "repository",
            "type": "command",
            "command": "extension.commandvariable.file.pickFile",
            "args": {
                "display": "transform",
                "description": "Select repository",
                "include": "CMakeLists.txt",
                "valueTransform": {
                    "text": "${file}",
                    "apply": [
                        {
                            "find": "^.*[\\\\/]([^\\\\/]+)[\\\\/]CMakeLists\\.txt$",
                            "replace": "$1"
                        }
                    ]
                },
                "labelTransform": "valueTransform"
            }
        },
        {
            "id": "profile",
            "type": "promptString",
            "description": "Conan profile",
            "default": "linux-clang19-debug"
        }
    ]
