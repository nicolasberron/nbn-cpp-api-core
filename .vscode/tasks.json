            "command": "python ${workspaceFolder:nbn-cpp-api-core}/scripts/run_nbn_task.py cmake-configure-debug --workspace ${workspaceFolder:nbn-cpp-api-core}/../${input:repository}",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
